{# @var element \craft\base\ElementInterface #}
{# @var sites \ContentReactor\Traduco\Models\SiteLanguage[] #}
{# @var disabled bool #}
{# @var isPro bool Whole elements are translated with the Pro edition #}
{% set id = 'traduco-' ~ random() %}
{% if not (isPro ?? true) %}
<div class="meta traduco">
	<div class="field">
		<div class="heading">
			<label>{{ craft.traduco.settings.pluginName }}</label>
		</div>
		<div class="input ltr">
			<p class="traduco-pro-notice light smalltext">
				{{ 'Translating whole elements comes with {plugin} Pro. Fields can be translated from their action menus.' | t('traduco', { plugin: craft.traduco.settings.pluginName }) }}
			</p>
		</div>
	</div>
</div>
{% else %}
<div class="meta traduco">
	<div class="field">
		<div class="heading">
			<label for="{{ id }}-site">{{ craft.traduco.settings.pluginName }}</label>
		</div>
		<div class="input ltr">
			<div class="traduco-controls">
				<div class="select">
					<select id="{{ id }}-site" class="traduco-target-site"
						data-id="{{ element.id }}"
						data-site-id="{{ element.siteId }}"
						aria-describedby="{{ id }}-notice"
						{% if disabled %}disabled data-locked="true"{% endif %}
					>
						<option value="">{{ 'Translate {elementType} into…' | t('traduco', {
							elementType: element.lowerDisplayName(),
						}) }}</option>
						{% for site in sites %}
							<option value="{{ site.siteId }}">{{ site.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="spinner hidden" aria-hidden="true"></div>
			</div>
			<p id="{{ id }}-notice" class="traduco-disabled-notice light smalltext"{% if not disabled %} hidden{% endif %}>
				{{ 'Only saved content can be translated, not drafts, unsaved changes or revisions.' | t('traduco') }}
			</p>
		</div>
	</div>
</div>

{% do craft.traduco.registerAsset(traducoAsset, 'css/element-sidebar.css') %}
{% do craft.traduco.registerAsset(traducoAsset, 'js/element-sidebar.js') %}
{% endif %}
